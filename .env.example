# 复制本文件为 .env，填入你的真实 key。
# .env 已在 .gitignore 中，不会被提交；.env.example 是安全模板，可以提交。

# 智谱 GLM（BigModel，OpenAI 兼容）
LLM_API_KEY=你的key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2

# 如果用 OpenAI 官方：把 BASE_URL 留空（或删掉），MODEL 改成 gpt-4o-mini 等
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
